        "required": [
          "distance",
          "name",
          "time",
          "type",
          "userId"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "distance": {
            "type": "number",
            "format": "double"
          },
          "time": {
            "type": "integer",
            "format": "int32"
          },
          "type": {
            "minLength": 1,
            "type": "string"
          },
          "calories": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "co2": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "moneySaved": {
            "type": "number",
            "format": "double",
